<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Shoaib Ali</Authors>
    <AssemblyName>empg</AssemblyName>
    <PackAsTool>True</PackAsTool>
    <PackageId>empg</PackageId>
    <ToolCommandName>empg</ToolCommandName>
    <Description>Command line tool for creating, inspecting and managing embedded PostgreSQL instances.</Description>
    <RepositoryUrl>https://github.com/alleey/EmbeddedPostgres</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alleey/EmbeddedPostgres</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Shoaib Ali</Copyright>
    <PackageTags>postgres;postgresql;pg;embed;embedded;server;.net 10;net 10.0;.net core;.net;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Trim lists are data, not code: what a build ships changes every release, so they are
       files a user can edit rather than lists compiled into the tool. -->
  <ItemGroup>
    <EmbeddedResource Include="TrimProfiles\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliFx" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="Microsoft.IdentityModel.Logging" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmbeddedPostgres.Core\EmbeddedPostgres.Core.csproj" />
    <ProjectReference Include="..\EmbeddedPostgres\EmbeddedPostgres.csproj" />
  </ItemGroup>

</Project>
